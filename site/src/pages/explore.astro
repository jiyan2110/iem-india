---
import Base from '../layouts/Base.astro';
import Explorer from '../components/Explorer.svelte';
import Overlays from '../components/Overlays.svelte';
import { meta } from '../lib/data';
---

<Base
  title="Explore the rankings · IEM India"
  description={`Filter, search and re-weight ${meta.counts.listed} wired IEMs sold in India under ₹10,000. Type-C and 3.5 mm are ranked separately.`}
>
  <section class="wrap head">
    <p class="eyebrow">Explorer</p>
    <h1>Rank them your way.</h1>
    <p class="lede">
      Every score is sound, hardware and box contents added up. Change the weights and the list re-orders. Type-C and
      3.5 mm are always ranked separately.
    </p>
  </section>
  <section class="wrap">
    <Explorer client:load />
  </section>
  <Overlays client:load />
</Base>

<style>
  .head {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: 1.2rem;
  }
  h1 {
    font-size: clamp(2rem, 6.5vw, 3.2rem);
  }
</style>
